// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProfileStatus {
  REGISTERED
  VERIFIED
  PROFILE_COMPLETED
  SUSPENDED
}

enum Species {
  Dog
  Cat
}

enum Gender {
  Male
  Female
}

model User{
  id String @id @default(uuid())

  phoneNumber String
  email String? @unique
  name String?
  location Location[]

  profileStatus ProfileStatus @default(REGISTERED)

  otps Otp[]
  pets Pet[]
  bookings Booking[]
  bookingGroups BookingGroup[]

  @@unique([phoneNumber])
  @@index([phoneNumber])
  @@index([email])
}

model Otp{
  id String @id @default(uuid())
  code String
  expiresAt DateTime

  userId String
  user User @relation(fields: [userId], references: [id])

  @@index ([userId])
}

model Location {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  label String

  placeId String
  address String
  latitude Float
  longitude Float

  bookings Booking[]
  bookingGroups BookingGroup[]

  @@index([placeId])
}

enum VaccinationStatus {
  UpToDate
  Partial
  None
}

model Pet {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  name String
  species Species
  breed String?
  ageMonths Int
  gender Gender
  vaccinationStatus VaccinationStatus
  medicalConditions Boolean
  medicalHistory String?

  bookings Booking[]
  bookingGroups BookingGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Service {
  Bathing
  Cutting
  Hygiene
  BlowDry
  NailTrim
  Spa
  Cleaning
}

enum BookingType {
  Instant
  Scheduled
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  petId String
  pet Pet @relation(fields: [petId], references: [id])

  locationId String
  location Location @relation(fields: [locationId], references: [id])

  type BookingType
  service Service
  status BookingStatus @default(PENDING)
  cancellationReason String?
  scheduledAt DateTime?

  groupId String?
  group BookingGroup? @relation(fields: [groupId], references: [id])

  serviceOptionId String?
  serviceOption ServiceOption? @relation(fields: [serviceOptionId], references: [id], onDelete: SetNull)
  durationMinutes Int?
  priceInRupees Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([petId])
  @@index([locationId])
  @@index([groupId])
}

model ServiceOption {
  id String @id @default(uuid())

  service Service
  durationMinutes Int
  label String
  priceInRupees Int
  sortOrder Int @default(0)
  isActive Boolean @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([service, durationMinutes])
  @@index([service])
}

model BookingGroup {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  petId String
  pet Pet @relation(fields: [petId], references: [id])

  locationId String
  location Location @relation(fields: [locationId], references: [id])

  totalPriceInRupees Int
  dayCount Int

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}