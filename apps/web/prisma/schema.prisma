// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProfileStatus {
  REGISTERED
  VERIFIED
  PROFILE_COMPLETED
  SUSPENDED
}

enum Species {
  Dog
  Cat
}

enum Gender {
  Male
  Female
}

model User{
  id String @id @default(uuid())

  phoneNumber String
  email String? @unique
  name String?
  location Location[]

  profileStatus ProfileStatus @default(REGISTERED)

  otps Otp[]
  pets Pet[]
  bookings Booking[]
  bookingGroups BookingGroup[]
  reviews Review[]

  createdAt DateTime @default(now())

  @@unique([phoneNumber])
  @@index([phoneNumber])
  @@index([email])
}

model Otp{
  id String @id @default(uuid())
  code String
  expiresAt DateTime

  userId String
  user User @relation(fields: [userId], references: [id])

  @@index ([userId])
}

model Location {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  label String

  placeId String
  address String
  latitude Float
  longitude Float

  bookings Booking[]
  bookingGroups BookingGroup[]

  @@index([placeId])
}

enum VaccinationStatus {
  UpToDate
  Partial
  None
}

model Pet {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  name String
  species Species
  breed String?
  ageMonths Int
  gender Gender
  vaccinationStatus VaccinationStatus
  medicalConditions Boolean
  medicalHistory String?

  bookings Booking[]
  bookingGroups BookingGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Service {
  Bathing
  Cutting
  Hygiene
  BlowDry
  NailTrim
  Spa
  Cleaning
  Walk
  HomeVisit
  PetSitting
}

enum BookingType {
  Instant
  Scheduled
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  petId String
  pet Pet @relation(fields: [petId], references: [id])

  locationId String
  location Location @relation(fields: [locationId], references: [id])

  type BookingType
  service Service
  status BookingStatus @default(PENDING)
  cancellationReason String?
  scheduledAt DateTime?

  groupId String?
  group BookingGroup? @relation(fields: [groupId], references: [id])

  serviceOptionId String?
  serviceOption ServiceOption? @relation(fields: [serviceOptionId], references: [id], onDelete: SetNull)
  durationMinutes Int?
  priceInRupees Int?

  notes String?

  walkerId String?
  walker Walker? @relation(fields: [walkerId], references: [id], onDelete: SetNull)

  report VisitReport?
  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([petId])
  @@index([locationId])
  @@index([groupId])
  @@index([walkerId])
}

model ServiceOption {
  id String @id @default(uuid())

  service Service
  durationMinutes Int
  label String
  priceInRupees Int
  sortOrder Int @default(0)
  isActive Boolean @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([service, durationMinutes])
  @@index([service])
}

model BookingGroup {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id])

  petId String
  pet Pet @relation(fields: [petId], references: [id])

  locationId String
  location Location @relation(fields: [locationId], references: [id])

  totalPriceInRupees Int
  discountInRupees Int @default(0)
  dayCount Int

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A vetted PawMile walker / carer who can be assigned to bookings.
model Walker {
  id String @id @default(uuid())

  name String
  phoneNumber String @unique
  city String
  area String?
  bio String?
  photoUrl String?
  yearsExperience Int @default(0)
  languages String[]
  isActive Boolean @default(true)

  bookings Booking[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
}

enum VisitMood {
  Happy
  Calm
  Energetic
  Anxious
}

// The "walk report" sent to the pet parent after a visit is completed.
model VisitReport {
  id String @id @default(uuid())

  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  startedAt DateTime?
  endedAt DateTime?
  distanceMeters Int?
  pee Boolean @default(false)
  poo Boolean @default(false)
  water Boolean @default(false)
  fed Boolean @default(false)
  mood VisitMood @default(Happy)
  note String
  photoUrl String?
  // Ordered [latitude, longitude] pairs of the walked route.
  route Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id String @id @default(uuid())

  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId String
  user User @relation(fields: [userId], references: [id])

  walkerId String?
  walker Walker? @relation(fields: [walkerId], references: [id], onDelete: SetNull)

  rating Int
  comment String?

  createdAt DateTime @default(now())

  @@index([walkerId])
  @@index([userId])
}

enum ApplicationStatus {
  NEW
  SHORTLISTED
  ONBOARDED
  REJECTED
}

model WalkerApplication {
  id String @id @default(uuid())

  name String
  phoneNumber String
  email String?
  city String
  area String
  experience String
  availability String[]
  hasOwnPet Boolean @default(false)
  about String?

  status ApplicationStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum EnquiryTopic {
  General
  Booking
  Partnership
  Press
  CityWaitlist
}

enum EnquiryStatus {
  NEW
  RESOLVED
}

model Enquiry {
  id String @id @default(uuid())

  topic EnquiryTopic @default(General)
  name String
  email String?
  phoneNumber String?
  city String?
  message String?

  status EnquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([topic])
}
